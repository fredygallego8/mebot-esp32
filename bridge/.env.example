# ── LLM (via LiteLLM proxy de OpenClaw o directo a OpenRouter) ──────────────
LITELLM_URL=http://openclaw-litellm:4000/v1
LLM_MODEL=deepseek/deepseek-chat-v3-0324
LLM_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXX

# Para llamar directo a OpenRouter (sin LiteLLM):
# LITELLM_URL=https://openrouter.ai/api/v1
# LLM_KEY=sk-or-v1-...

# ── Whisper STT ──────────────────────────────────────────────────────────────
# Opciones: tiny | base | small | medium
# small = mejor balance CPU/calidad (~2-4s por frase)
MEBOT_WHISPER_MODEL=small
MEBOT_LANGUAGE=es

# ── Edge-TTS ─────────────────────────────────────────────────────────────────
# Lista completa: edge-tts --list-voices
# MeBot brand voice: es-ES-ElviraNeural (cálida, natural)
MEBOT_TTS_VOICE=es-ES-ElviraNeural

# ── MeBot Brand voice / identidad ──────────────────────────────────────────
# B6: Greeting personalizado con nombre. %s se reemplaza por bot_name del perfil
MEBOT_GREETING=Hola, soy %s. Estoy lista.
MEBOT_BOT_NAME=MeBot
MEBOT_WIFI_GREET=Hola, Estoy de vuelta

# ── LLM avanzado ─────────────────────────────────────────────────────────────
MEBOT_MAX_TOKENS=200
MEBOT_MAX_HISTORY=6
MEBOT_LLM_TIMEOUT=30
MEBOT_SYSTEM_PROMPT=Eres un asistente de voz compacto integrado en un dispositivo ESP32. Responde de forma breve (máximo 2-3 oraciones). Habla en el mismo idioma que el usuario. Nunca uses emojis ni markdown, solo texto plano.

# ── Conversaciones (T6) ──────────────────────────────────────────────────────
MEBOT_CONVERSATION_LOG=conversations.jsonl

# ── Servidor ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── ESP32 auto-config (endpoint OTA) ────────────────────────────────────────
# El ESP32 llama a GET /xiaozhi/ota/ al arrancar.
# Con MEBOT_PUBLIC_HOST configurado, le devuelve automáticamente la URL WSS.
# Apunta el ESP32 a: https://<MEBOT_PUBLIC_HOST>/xiaozhi/ota/
MEBOT_PUBLIC_HOST=bot6admin.mebot.online
# Token opcional para autenticar el WebSocket (dejar vacío si no se usa)
MEBOT_WS_TOKEN=
