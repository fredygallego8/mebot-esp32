# cmake/mebot_build_number.cmake
# Incrementa el build number en build_number.txt y genera main/mebot_build_info.h
# Se ejecuta en cada `idf.py build` via cmake -P.
#
# Usa CMAKE_CURRENT_LIST_FILE para derivar el root del proyecto —
# funciona en script mode donde CMAKE_SOURCE_DIR apunta al CWD (no al proyecto).

get_filename_component(SCRIPT_DIR  "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
get_filename_component(PROJECT_ROOT "${SCRIPT_DIR}/.." ABSOLUTE)

set(BUILD_NUM_FILE "${PROJECT_ROOT}/build_number.txt")
set(BUILD_INFO_H   "${PROJECT_ROOT}/main/mebot_build_info.h")
message(STATUS "MeBot project root: ${PROJECT_ROOT}")

# Leer número actual
if(EXISTS "${BUILD_NUM_FILE}")
    file(READ "${BUILD_NUM_FILE}" BUILD_NUM)
    string(STRIP "${BUILD_NUM}" BUILD_NUM)
else()
    set(BUILD_NUM "0")
endif()

# Incrementar en cada build — cada build = nueva version
math(EXPR BUILD_NUM "${BUILD_NUM} + 1")

# Guardar
file(WRITE "${BUILD_NUM_FILE}" "${BUILD_NUM}")

# Generar header
file(WRITE "${BUILD_INFO_H}"
"/* Auto-generated by cmake/mebot_build_number.cmake — NO EDITAR */
#pragma once
#define MEBOT_BUILD_NUMBER ${BUILD_NUM}
#define MEBOT_BUILD_NUMBER_STR \"b${BUILD_NUM}\"
")

message(STATUS "MeBot build number: ${BUILD_NUM}")
